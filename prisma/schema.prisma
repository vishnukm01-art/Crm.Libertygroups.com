generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  password        String
  role            String   @default("client") // admin, sub_admin, client, ib
  phone           String?
  country         String?
  status          String   @default("pending") // pending, active, inactive, blocked
  kycStatus       String   @default("pending") // pending, approved, rejected
  mt5Account      String?
  mt5Group        String?
  leverage        String?
  marketingName   String?
  walletBalance   Float    @default(0)
  twoFactorEnabled Boolean @default(false)
  followUpStatus  String?
  followUpNote    String?
  followUpDate    DateTime?
  referralLink    String?
  totalCommission Float    @default(0)
  availableCommission Float @default(0)
  isIB            Boolean  @default(false)
  ibParentId      String?
  ibParent        User?    @relation("IBTree", fields: [ibParentId], references: [id])
  ibChildren      User[]   @relation("IBTree")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documents       Document[]
  bankDetails     BankDetail[]
  bonuses         Bonus[]
  deposits        Transaction[] @relation("UserDeposits")
  withdrawals     Transaction[] @relation("UserWithdrawals")
  tickets         Ticket[]
  notifications   UserNotification[]
  ibRequests      IBRequest[]
  mt5Accounts     Mt5Account[]
}

model Mt5Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  mt5Login    String   @unique
  mt5Group    String
  leverage    String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions        Transaction[] @relation("Mt5AccountTransactions")
  incomingTransfers   Transaction[] @relation("Mt5AccountIncomingTransfers")
}

model Document {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // id_proof, address_proof, selfie, etc.
  fileName    String
  filePath    String
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BankDetail {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  bankName      String
  accountNumber String
  ifscCode      String?
  swiftCode     String?
  accountType   String?
  accountName   String?
  ibanNumber    String?
  bankAddress   String?
  country       String?
  bookBankFile  String?
  comment       String?
  status        String   @default("pending") // pending, approved, rejected
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("UserDeposits", fields: [userId], references: [id])
  withdrawUser    User?    @relation("UserWithdrawals", fields: [withdrawUserId], references: [id])
  withdrawUserId  String?
  mt5AccountId    String?
  mt5AccountRef   Mt5Account? @relation("Mt5AccountTransactions", fields: [mt5AccountId], references: [id])
  toMt5AccountId  String?
  toMt5AccountRef Mt5Account? @relation("Mt5AccountIncomingTransfers", fields: [toMt5AccountId], references: [id])
  type            String   // deposit, withdraw, ib_withdraw, transfer
  amount          Float
  currency        String   @default("USD")
  status          String   @default("pending") // pending, approved, rejected, completed
  paymentMethod   String?
  reference       String?
  notes           String?
  proofFilePath   String?
  adminComment    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Bonus {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // credit, debit
  amount    Float
  reason    String?
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model IBCommission {
  id            String   @id @default(cuid())
  ibUserId      String
  level         Int
  commissionType String  // per_lot, percentage
  value         Float
  groupName     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model IBRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  reason       String?
  status       String    @default("pending") // pending, approved, rejected
  adminComment String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  leverage    String?
  commission  Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketingPartner {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  commission  Float?
  country     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id               String   @id @default(cuid())
  title            String
  content          String
  shortDescription String?
  image            String?
  isPublished      Boolean  @default(false)
  isTrending       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("general") // general, deposit, withdraw, kyc
  createdAt DateTime @default(now())

  userNotifications UserNotification[]
}

model UserNotification {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id])
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Ticket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subject     String
  message     String
  status      String   @default("open") // open, in_progress, closed
  priority    String   @default("medium") // low, medium, high
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   // deposit_bonus, volume_bonus, loyalty
  value       Float
  minDeposit  Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  group String @default("general") // general, payment, email, sms
}

model SubAdmin {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  permissions String   // JSON string of permissions
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model MarketingUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  password     String
  incentive    Float    @default(0)
  netDeposit   Float    @default(0)
  role         String   @default("team_manager")
  isActive     Boolean  @default(true)
  totalWithdraw Float   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leads        Lead[]
}

model Lead {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String?
  country         String?
  status          String        @default("new")
  marketingUserId String
  marketingUser   MarketingUser @relation(fields: [marketingUserId], references: [id])
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  secret    String
  events    String   // Comma-separated list of event types
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Voice Jar ───────────────────────────────────────────────────────────────

enum InteractionType {
  AUDIO
  VIDEO
  CHAT
}

enum InteractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Interaction {
  id             String            @id @default(cuid())
  type           InteractionType   @default(AUDIO)
  status         InteractionStatus @default(PENDING)
  agentName      String?
  customerName   String?
  direction      String?           // inbound, outbound
  duration       Int?              // seconds
  sentiment      String?           // positive, neutral, negative
  score          Int?              // 0-100
  transcript     String?           @db.Text
  transcriptJson Json?             // Whisper segments [{ start, end, text }]
  summaryJson    Json?             // structured summary from GPT
  audioUrl       String?
  audioFileName  String?
  autoFailed     Boolean           @default(false)
  failReason     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  interactionOutcomes            InteractionOutcome[]
  interactionStrengths           InteractionStrength[]
  interactionWeaknesses          InteractionWeakness[]
  interactionMissedOpportunities InteractionMissedOpportunity[]
  listItems                      InteractionListItem[]
}

model InteractionOutcome {
  id             String      @id @default(cuid())
  interactionId  String
  interaction    Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  name           String
  description    String?     @db.Text
  timeReferences Json?       // [{ startTime: Float, endTime: Float, label: String }]
}

model InteractionStrength {
  id             String      @id @default(cuid())
  interactionId  String
  interaction    Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  name           String
  description    String?     @db.Text
  timeReferences Json?
}

model InteractionWeakness {
  id             String      @id @default(cuid())
  interactionId  String
  interaction    Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  name           String
  description    String?     @db.Text
  timeReferences Json?
}

model InteractionMissedOpportunity {
  id             String      @id @default(cuid())
  interactionId  String
  interaction    Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  name           String
  description    String?     @db.Text
  timeReferences Json?
}

enum ListVisibility {
  PERSONAL
  PUBLIC
}

model InteractionList {
  id          String         @id @default(cuid())
  name        String
  description String?        @db.Text
  visibility  ListVisibility @default(PERSONAL)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items InteractionListItem[]
}

model InteractionListItem {
  id            String          @id @default(cuid())
  listId        String
  list          InteractionList @relation(fields: [listId], references: [id], onDelete: Cascade)
  interactionId String
  interaction   Interaction     @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  addedAt       DateTime        @default(now())
  notes         String?         @db.Text

  @@unique([listId, interactionId])
}
